# Credenciais administrativas e tokens são segredos apenas do servidor.
ADMIN_USERNAME=defina-um-login-administrativo
ADMIN_PASSWORD_HASH=cole-aqui-o-resultado-do-script-scrypt
ADMIN_SESSION_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-bytes

# As chaves anon do Supabase são públicas por desenho e dependem de RLS.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-publica-anon
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Configure quando o repositório GitHub do projeto estiver disponível.
GITHUB_REPOSITORY=organizacao/repositorio
GITHUB_TOKEN=token-de-leitura-do-repositorio
